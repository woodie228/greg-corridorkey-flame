@@ -0,0 +1,30 @@
+# SPDX-License-Identifier: Apache-2.0
+# Local regression tests for explicit active-area inference.
+import tempfile
+from pathlib import Path
+import unittest
+import cv2
+import numpy as np
+from corridorkey_mlx.pipeline import Source, pad_image
+
+
+class ActiveAreaTests(unittest.TestCase):
+    def test_crops_only_explicit_area_then_reflects_without_resizing(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);image=np.zeros((64,128,3),np.uint8)
+            image[:,20:108]=np.arange(88,dtype=np.uint8)[None,:,None]+40
+            image[0,20:25]=0  # Legitimate dark prop on the active boundary.
+            cv2.imwrite(str(root/'0000.png'),image)
+            source=Source(root,active_area=(20,0,88,64),profile_hw=(128,128))
+            frame=next(source.frames())
+            np.testing.assert_array_equal(frame,image[:,20:108])
+            self.assertEqual(source.padded,(128,128))
+            padded=pad_image(frame,source.padded)
+            np.testing.assert_array_equal(padded[32:96,20:108],frame)
+            self.assertTrue(np.all(frame[0,:5]==0))
+
+    def test_rejects_invalid_active_area_and_small_profile(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);cv2.imwrite(str(root/'0000.png'),np.zeros((128,256,3),np.uint8))
+            with self.assertRaises(ValueError):Source(root,active_area=(250,0,20,128),profile_hw=(128,256))
+            with self.assertRaises(ValueError):Source(root,active_area=(0,0,200,128),profile_hw=(128,128))
