diff --git a/tests/test_hint_policy.py b/tests/test_hint_policy.py
new file mode 100644
index 0000000..9322efc
--- /dev/null
+++ b/tests/test_hint_policy.py
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: Apache-2.0
+# Local regression tests added for Greg CorridorKey Flame Tools.
+"""Synthetic regression checks for the local carried-hint control."""
+import unittest
+from corridorkey_mlx.pipeline import select_hint
+
+
+class HintPolicyTests(unittest.TestCase):
+    def test_disabled_carry_does_not_feed_back_model_predictions(self):
+        self.assertIsNone(select_hint(2, None, {2: 'model-prediction'}, None, False))
+
+    def test_disabled_carry_preserves_explicit_first_and_full_frame_hints(self):
+        self.assertEqual(select_hint(0, 'initial', {0: 'carried'}, 'explicit', False), 'initial')
+        self.assertEqual(select_hint(2, None, {2: 'carried'}, 'explicit', False), 'explicit')
+
+    def test_enabled_carry_retains_previous_behavior(self):
+        self.assertEqual(select_hint(2, None, {2: 'carried'}, 'explicit', True), 'carried')
+        self.assertEqual(select_hint(3, None, {2: 'carried'}, 'explicit', True), 'explicit')
+
+class HintCLIForwardingTests(unittest.TestCase):
+    def test_no_carry_flag_reaches_pipeline(self):
+        import contextlib
+        import io
+        import tempfile
+        from pathlib import Path
+        from unittest.mock import patch
+        import cv2
+        import numpy as np
+        from corridorkey_mlx.cli import main, required_files
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            plate = root / 'plate.png'
+            cv2.imwrite(str(plate), np.zeros((128, 128, 3), np.uint8))
+            for path in required_files(root, 128, 128, 1):
+                path.parent.mkdir(parents=True, exist_ok=True)
+                path.write_text('{"precision":"fp32"}')
+            args = ['--input', str(plate), '--output-dir', str(root / 'out'),
+                    '--model-root', str(root), '--height', '128', '--width', '128',
+                    '--image-sequence', '--no-carry-hint']
+            with patch('corridorkey_mlx.mlx_backend.MLXModel'), patch('corridorkey_mlx.pipeline.run') as run:
+                with contextlib.redirect_stdout(io.StringIO()):
+                    self.assertEqual(main(args), 0)
+                self.assertIs(run.call_args.kwargs['carry_hint'], False)
+
+
+if __name__ == '__main__':
+    unittest.main()
